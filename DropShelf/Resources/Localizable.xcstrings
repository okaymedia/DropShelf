    "DropShelf keeps files at hand while you work. It only stores references — your original files are never copied, moved or deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DropShelf keeps files at hand while you work. It only stores references — your original files are never copied, moved or deleted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DropShelf, çalışırken dosyalarınızı elinizin altında tutar. Yalnızca referansları saklar; orijinal dosyalarınız asla kopyalanmaz, taşınmaz veya silinmez."
          }
        }
      }
    },
    "Drop & drag": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop & drag"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükle bırak"
          }
        }
      }
    },
    "Drag files or folders from Finder onto the shelf. Later, drag them from the shelf into Finder, Mail or any app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag files or folders from Finder onto the shelf. Later, drag them from the shelf into Finder, Mail or any app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları veya klasörleri Finder’dan rafa sürükleyin. Daha sonra raftan Finder’a, Mail’e veya başka bir uygulamaya sürükleyebilirsiniz."
          }
        }
      }
    },
